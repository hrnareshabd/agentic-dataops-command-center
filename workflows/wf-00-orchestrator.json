    {
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst scheduled=Boolean(input.timestamp);\nconst target_date=input.target_date || (scheduled ? $now.setZone('Europe/Berlin').minus({days:1}).toISODate() : '2026-09-28');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(target_date)) throw new Error('Invalid target_date');\nconst dry_run=input.dry_run ?? true;\nif(typeof dry_run!=='boolean') throw new Error('dry_run must be boolean');\nreturn [{json:{target_date,mode:dry_run?'dry_run':'production',dry_run,namespace:dry_run?'DRY_RUN':'PRODUCTION',orchestrator_execution_id:String($execution.id),started_at:$now.toISO(),trigger_source:scheduled?'schedule':'manual',schedule_timezone:'Europe/Berlin'}}];"
      },
      "id": "5fc46188-deb8-4f79-a9c1-b35fa5b09a5b",
      "name": "Initialize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        -512
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS target_date, $2::text AS mode, (SELECT run_id FROM public.pipeline_runs WHERE pipeline_name='orders_daily_etl' AND (started_at AT TIME ZONE 'Europe/Berlin')::date=$1::date AND finished_at IS NOT NULL ORDER BY finished_at DESC,run_id DESC LIMIT 1) AS pipeline_run_id;",
        "options": {
          "queryReplacement": "={{ [$json.target_date,$json.mode] }}"
        }
      },
      "id": "56ccd7bf-6b76-4a9e-9085-19f73e7614fc",
      "name": "Resolve Pipeline Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1488,
        -512
      ]
    },
    {
      "parameters": {
        "jsCode": "const context=$('Initialize Run').first().json;\nconst run=Number($json.pipeline_run_id);\nif(!$json.pipeline_run_id || !Number.isSafeInteger(run) || run<=0) throw new Error('NO_UPSTREAM_RUN: No finished orders_daily_etl run exists for '+context.target_date);\nreturn [{json:{...context,pipeline_run_id:run}}];"
      },
      "id": "b100c3e7-9858-4b4a-b7ca-afe45f4c772d",
      "name": "Validate Run Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
