    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\nINSERT INTO public.dataops_orchestrator_runs(namespace,run_id,incident_date,execution_id,status)\nVALUES ($1,$2::bigint,$3::date,$4,'RUNNING') ON CONFLICT DO NOTHING RETURNING run_id\n)\nSELECT (EXISTS(SELECT 1 FROM claimed) OR EXISTS(SELECT 1 FROM public.dataops_orchestrator_runs WHERE namespace=$1 AND run_id=$2::bigint AND incident_date=$3::date AND execution_id=$4 AND status='RUNNING')) AS claimed, $1::text AS namespace,CASE WHEN $1='DRY_RUN' THEN 'dry_run' ELSE 'production' END AS mode,$2::bigint AS pipeline_run_id,$3::text AS target_date,$4::text AS orchestrator_execution_id;",
        "options": {
          "queryReplacement": "={{ [$json.namespace,$json.pipeline_run_id,$json.target_date,$json.orchestrator_execution_id] }}"
        }
      },
