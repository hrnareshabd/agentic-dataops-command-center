    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('WF-02 must return exactly one item');\nconst result = items[0].json;\nif (result.workflow !== 'WF-02' || result.status !== 'COMPLETED') throw new Error('WF-02 did not complete');\nconst analytics = result.analytics;\nif (!analytics || typeof analytics !== 'object' || Array.isArray(analytics)) throw new Error('Missing structured analytics');\nconst context = $('Prepare Run Context').first().json;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(context.target_date)) throw new Error('Invalid incident date');\nif (!Number.isSafeInteger(context.pipeline_run_id) || context.pipeline_run_id <= 0) throw new Error('pipeline_run_id must be a positive integer');\nconst dq = $('Evaluate DQ Result').first().json.data_quality;\nconst numberFrom = (value, label, percentage = false) => {\n  const text = String(value).trim().replace(percentage ? /%$/ : /$^/, '');\n  if (!/^-?\\d+(?:\\.\\d+)?$/.test(text)) throw new Error('Invalid numeric analytics field: ' + label);\n  const number = Number(text);\n  if (!Number.isFinite(number)) throw new Error('Invalid number: ' + label);\n  return number;\n};\nreturn [{json: {\n  incident_date: context.target_date,\n  run_id: context.pipeline_run_id,\n  orchestrator_execution_id: context.orchestrator_execution_id,\n  data_quality: {\n    severity: dq.diagnosis.severity,\n    score: dq.score,\n    health: dq.health,\n    findings: dq.checks.map(check => ({...check, evidence: dq.diagnosis.findings.find(f => f.check_name === check.check_name)?.evidence || JSON.stringify(check.details)})),\n    diagnosis: dq.diagnosis\n  },\n  analytics: {\n    target_revenue: numberFrom(analytics.target_value, 'target_value'),\n    avg_revenue_prev_7d: numberFrom(analytics.baseline_value, 'baseline_value'),\n    absolute_difference: numberFrom(analytics.absolute_difference, 'absolute_difference'),\n    percentage_change: numberFrom(analytics.percentage_change, 'percentage_change', true),\n    summary: analytics.summary,\n    insights: analytics.insights,\n    root_cause_status: analytics.root_cause_status\n  }\n}}];"
      },
