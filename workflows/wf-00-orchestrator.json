    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('WF-01 must return exactly one item');\nconst result = items[0].json;\nif (result.workflow !== 'WF-01' || result.status !== 'COMPLETED') throw new Error('WF-01 did not complete');\nconst dq = result.data_quality;\nconst context = $('Prepare Run Context').first().json;\nif (!dq || typeof dq !== 'object' || Array.isArray(dq)) throw new Error('Missing structured data_quality');\nif (dq.target_date !== context.target_date) throw new Error('DQ report date does not match run context');\nif (!Array.isArray(dq.checks) || dq.checks.length !== 5) throw new Error('Incomplete DQ checks');\nif (dq.health === 'INCOMPLETE' || dq.checks.some(c => c.status === 'NO_DATA')) throw new Error('DQ result is incomplete; do not report a healthy run');\nif (!['HEALTHY', 'ISSUES_DETECTED'].includes(dq.health)) throw new Error('Unknown DQ health');\nif (typeof dq.score !== 'number' || !Number.isFinite(dq.score)) throw new Error('Invalid DQ score');\nif (dq.health === 'HEALTHY' && dq.checks.some(c => c.status !== 'PASS')) throw new Error('Inconsistent healthy DQ result');\nreturn [{json: {incident_detected: dq.health === 'ISSUES_DETECTED', severity: dq.diagnosis?.severity || 'UNKNOWN', data_quality: dq, run_context: context}}];"
      },
