        "subject": "[DataOps] WF-00 automation failure",
        "emailType": "text",
        "message": "={{ ['WF-00 automation failed at '+$('Build Automation Failure').first().json.failed_stage+'.','Review execution: '+$('Build Automation Failure').first().json.execution_url,'Check the run claim before retrying. Production actions still require human approval.'].join('\\n') }}",
        "options": {
          "appendAttribution": false
        }
