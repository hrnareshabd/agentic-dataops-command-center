    {
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst source_execution_id=String(input.execution?.id || '');\nif(source_execution_id && !/^\\d+$/.test(source_execution_id)) throw new Error('Invalid source execution ID');\nconst failed_stage=input.execution?.lastNodeExecuted || input.trigger?.error?.node?.name || 'trigger/unknown';\nreturn [{json:{workflow:'WF-00',status:'FAILED',failure_kind:'UNHANDLED_AUTOMATION_ERROR',source_execution_id,failed_stage,source_workflow_id:String(input.workflow?.id || 'CONFIGURE_WF_00_ID'),execution_url:source_execution_id ? 'https://YOUR-N8N-INSTANCE.example/workflow/CONFIGURE_WF_00_ID/executions/'+source_execution_id : 'https://YOUR-N8N-INSTANCE.example/workflow/CONFIGURE_WF_00_ID',message:'Automation failed. Review the private execution; error details are not included in email.'}}];"
      },
      "id": "c32239cd-0c88-4109-b658-df0b269029f3",
      "name": "Build Automation Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        -144
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.dataops_orchestrator_runs SET status='FAILED',completed_at=now(),result=$1::jsonb WHERE execution_id=$2 AND status='RUNNING';",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json),$json.source_execution_id] }}"
        }
      },
      "id": "580f74f2-3d51-4b96-9dc0-62254d362896",
      "name": "Mark Owning Run Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
